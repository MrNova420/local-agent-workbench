{
  "name": "local-agent-workbench",
  "productName": "Local Agent Workbench",
  "version": "0.1.0-beta.3",
  "author": "Local Agent Workbench",
  "private": true,
  "description": "A local-first development workbench for Ollama and Hugging Face models.",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && python -m pytest -q tests",
    "test:watch": "vitest",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "package": "npm run sidecar:build && electron-forge package",
    "make": "npm run sidecar:build && electron-forge make"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "highlight.js": "^11.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrNova420/local-agent-workbench.git"
  },
  "homepage": "https://github.com/MrNova420/local-agent-workbench#readme",
  "bugs": {
    "url": "https://github.com/MrNova420/local-agent-workbench/issues"
  }
}
